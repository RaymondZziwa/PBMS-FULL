model SeedlingStages {
  id                    Int                    @id @default(autoincrement())
  name                  String
  stageDays             Float
  updatedAt             DateTime               @updatedAt
  createdAt             DateTime               @default(now())
  seedlingBatches       SeedlingBatch[]
  seedlingBatchTrackers SeedlingBatchTracker[]
  seedlingDeaths        SeedlingDeath[]

  @@index([name])
  @@index([createdAt])
}

model SeedlingBatch {
  id                      Int                    @id @default(autoincrement())
  batchNumber             String
  currentStageId          Int
  currentStage            SeedlingStages         @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  seedlings               Json
  daysSpentInCurrentStage Float
  status                  SeedlingGrowthStatus
  notes                   String?
  updatedAt               DateTime               @updatedAt
  createdAt               DateTime               @default(now())
  seedlingBatchTrackers   SeedlingBatchTracker[]
  seedlingDeaths          SeedlingDeath[]
}

model SeedlingBatchTracker {
  id                          Int            @id @default(autoincrement())
  batchId                     Int
  batch                       SeedlingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  currentStageId              Int
  currentStage                SeedlingStages @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  startDate                   DateTime
  endDate                     DateTime
  seedlingsLostAtCurrentStage Json?
  daysToNextStage             Float
  updatedAt                   DateTime       @updatedAt
  createdAt                   DateTime       @default(now())
}

model SeedlingDeath {
  id        Int            @id @default(autoincrement())
  batchId   Int
  batch     SeedlingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stageId   Int
  stage     SeedlingStages @relation(fields: [stageId], references: [id], onDelete: Cascade)
  seedlings Json
  reason    String?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

// Manufacturing model - Product manufacturing records
model Manufacturing {
  id              Int                 @id @default(autoincrement())
  storeId         Int
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  primaryUnitId   Int // Unit ID for primary unit (L or KG)
  primaryUnit     Unit                @relation("PrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: Cascade)
  unitId          Int // Unit ID for packing unit
  unit            Unit                @relation("PackingUnit", fields: [unitId], references: [id], onDelete: Cascade)
  totalQuantity   Float // Total quantity in primary unit (L or KG)
  estimatedOutput Float // Estimated number of output units/pieces
  actualOutput    Float? // Actual number of output units/pieces (filled after packing)
  status          ManufacturingStatus @default(PENDING) // Status: PENDING, NORMAL, WASTAGE_DETECTED, GOOD_UTILIZATION
  items           Json // Array of manufacturing items: [{ itemId, itemName, quantity }]
  manufacturedBy  Int
  employee        Employee            @relation(fields: [manufacturedBy], references: [id], onDelete: Cascade)
  notes           String?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  @@index([storeId, createdAt])
  @@index([manufacturedBy, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("manufacturing")
}

model BillingChannel {
  id          Int         @id @default(autoincrement())
  utility     UtilityType
  name        String?
  meterNumber String
  isVerified  Boolean     @default(false)
  area        String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@index([name])
  @@map("billing_channels")
}


// ---------------------------------------------------------------------------
// Monk Loyalty Club
// ---------------------------------------------------------------------------

enum ClubMemberStatus {
  PENDING          // applied, waiting for approval
  REJECTED
  AWAITING_PAYMENT // approved, must pay the registration fee
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ClubPaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum ClubPayoutStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model ClubMember {
  id                 Int              @id @default(autoincrement())
  title              String           @db.VarChar(10)
  surname            String           @db.VarChar(80)
  firstName          String           @db.VarChar(80)
  otherName          String?          @db.VarChar(80)
  idType             String           @db.VarChar(20) // NATIONAL_ID | PASSPORT
  idNumber           String           @unique @db.VarChar(40)
  country            String           @db.VarChar(60)
  district           String?          @db.VarChar(80)
  county             String?          @db.VarChar(120)
  subCounty          String?          @db.VarChar(120)
  address            String?          @db.VarChar(255) // village / street, or full address outside Uganda
  phone1             String           @unique @db.VarChar(20) // stored as +2567XXXXXXXX
  phone2             String?          @db.VarChar(20)
  email              String?          @unique @db.VarChar(191)
  profession         String?          @db.VarChar(120)
  photo              String?          @db.VarChar(255)
  agreedAt           DateTime
  status             ClubMemberStatus @default(PENDING)
  statusNote         String?          @db.Text
  cardNumber         String?          @unique @db.VarChar(20)
  /// Bumped by "Reissue card": older QR codes for this card stop working.
  cardVersion        Int              @default(1)
  /// Last time the card's QR code was checked, and how often.
  cardCheckedAt      DateTime?
  cardChecks         Int              @default(0)
  password           String?          @db.VarChar(100)
  mustChangePassword Boolean          @default(true)
  /// Bumped on password change, suspension etc. to sign the member out everywhere.
  tokenVersion       Int              @default(0)
  approvedAt         DateTime?
  approvedById       Int?
  activatedAt        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  nextOfKin   ClubNextOfKin[]
  attachments ClubAttachment[]
  payments    ClubPayment[]
  trackerRows ClubTrackerEntry[]
  trackerYears ClubTrackerYear[]
  orders       ClubOrder[]

  @@index([status, createdAt])
  @@index([surname, firstName])
  @@map("club_members")
}

model ClubNextOfKin {
  id           Int        @id @default(autoincrement())
  memberId     Int
  member       ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position     Int        // 1 to 4; 1 is required
  fullName     String     @db.VarChar(160)
  relationship String     @db.VarChar(60)
  address      String?    @db.VarChar(255)
  phone        String     @db.VarChar(20)
  email        String?    @db.VarChar(191)
  profession   String?    @db.VarChar(120)

  @@unique([memberId, position])
  @@map("club_next_of_kin")
}

model ClubAttachment {
  id        Int        @id @default(autoincrement())
  memberId  Int
  member    ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String     @db.VarChar(120)
  fileName  String     @db.VarChar(255) // stored name in private/club (never public)
  mimeType  String     @db.VarChar(100)
  size      Int
  createdAt DateTime   @default(now())

  @@index([memberId])
  @@map("club_attachments")
}

model ClubPayment {
  id           Int               @id @default(autoincrement())
  memberId     Int?
  member       ClubMember?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName   String            @db.VarChar(200) // kept if the member is deleted
  purpose      String            @db.VarChar(30) // REGISTRATION | ORDER
  orderId      Int?              // set when purpose = ORDER
  baseAmount   Decimal           @db.Decimal(12, 2) // what the wallet receives
  marzFee      Decimal           @db.Decimal(12, 2)
  serviceFee   Decimal           @db.Decimal(12, 2)
  totalCharged Decimal           @db.Decimal(12, 2)
  phone        String            @db.VarChar(20)
  reference    String            @unique @db.VarChar(64)
  providerRef  String?           @db.VarChar(120)
  status       ClubPaymentStatus @default(PENDING)
  credited     Boolean           @default(false)
  failureNote  String?           @db.VarChar(255)
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
  @@map("club_payments")
}

model ClubPayout {
  id          Int              @id @default(autoincrement())
  amount      Decimal          @db.Decimal(12, 2)
  channelId   Int
  description String?          @db.VarChar(255)
  reference   String           @unique @db.VarChar(120)
  status      ClubPayoutStatus @default(PENDING)
  requestedBy Int
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdAt])
  @@map("club_payouts")
}

/// How many lots a member's tracker has in a year.
model ClubTrackerYear {
  id       Int        @id @default(autoincrement())
  memberId Int
  member   ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year     Int
  lots     Int        @default(4)

  @@unique([memberId, year])
  @@map("club_tracker_years")
}

/// One cell of the tracker: a member's quantity and receipt for a lot in a month.
model ClubTrackerEntry {
  id          Int        @id @default(autoincrement())
  memberId    Int
  member      ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  year        Int
  month       Int // 1-12
  lot         Int // 1..n
  quantity    Decimal?   @db.Decimal(12, 2)
  receiptNo   String?    @db.VarChar(60)
  updatedById Int?
  updatedAt   DateTime   @updatedAt

  @@unique([memberId, year, month, lot])
  @@index([memberId, year])
  @@map("club_tracker_entries")
}

/// Club-wide settings (one row, id = 1), changed in PBMS → Monk Loyalty Club → Settings.
model ClubSetting {
  id              Int      @id @default(1)
  /// Discount members get in the marketplace, in percent (0–90).
  discountPercent Int      @default(0)
  /// Store whose stock is shown in the marketplace (null = don't check stock).
  storeId         Int?
  updatedById     Int?
  updatedAt       DateTime @updatedAt

  @@map("club_settings")
}

enum ClubOrderStatus {
  AWAITING_PAYMENT // mobile money not confirmed yet
  PLACED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ClubPaymentMethod {
  CASH
  ON_DELIVERY
  MOBILE_MONEY
}

model ClubOrder {
  id              Int               @id @default(autoincrement())
  orderNumber     String            @unique @db.VarChar(24)
  memberId        Int?
  member          ClubMember?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName      String            @db.VarChar(200)
  cardNumber      String?           @db.VarChar(20)
  recipientName   String            @db.VarChar(160)
  deliveryPhone   String            @db.VarChar(20)
  deliveryAddress String            @db.VarChar(500)
  usedDefaultAddress Boolean        @default(true)
  paymentMethod   ClubPaymentMethod
  status          ClubOrderStatus   @default(PLACED)
  paid            Boolean           @default(false)
  subtotal        Decimal           @db.Decimal(12, 2)
  discountPercent Int               @default(0)
  discountAmount  Decimal           @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  notes           String?           @db.VarChar(500)
  statusNote      String?           @db.VarChar(500)
  updatedById     Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items ClubOrderItem[]

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@map("club_orders")
}

model ClubOrderItem {
  id        Int       @id @default(autoincrement())
  orderId   Int
  order     ClubOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    Int?
  name      String    @db.VarChar(191)
  unitPrice Decimal   @db.Decimal(12, 2) // price before the club discount
  qty       Int
  lineTotal Decimal   @db.Decimal(12, 2)

  @@index([orderId])
  @@map("club_order_items")
}
