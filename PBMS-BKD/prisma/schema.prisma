generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS - Keep as is, they're efficient
enum InventoryRecordCategory {
  RESTOCK
  DEPLETION
  TRANSFER
  ADJUSTMENT
  MANUFACTURING
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum ChannelType {
  BANK_TRANSFER
  MOBILE_MONEY
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StockTransferStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum PaymentType {
  CASH
  CHEQUE
  MOBILE_MONEY
  BARTER_PAYMENT
}

enum UtilityType {
  LIGHT
  NWSC
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  TRANSPORT
  INSURANCE
  MARKETING
  TRAINING
  TAXES
  MEDICAL_SUPPLIES
  OFFICE_SUPPLIES
  EQUIPMENT_PURCHASE
  EQUIPMENT_REPAIR
  CLEANING
  SECURITY
  INTERNET
  WATER
  ELECTRICITY
  COMMUNICATION
  SOFTWARE_SUBSCRIPTIONS
  MISCELLANEOUS
}

enum Gender {
  MALE
  FEMALE
}

enum ChequeStatus {
  PENDING
  PAID
  BOUNCED
}

enum PatientAcountTransactionType {
  DEPOSIT
  PURCHASE_PAYMENT
}

enum Status {
  APPROVED
  PENDING
  REJECTED
}

enum EventStatus {
  OPEN
  CLOSED
}

enum EventPaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum PaymentStatus {
  FULLY_PAID
  PARTIALLY_PAID
  UNPAID
}

enum SaleStatus {
  PENDING
  FAILED
  SUCCESSFUL
}

enum PaymentMethodType {
  CASH
  MTN_MOMO
  AIRTEL_MOMO
  CARD
  PROF_MOMO
  PATIENT_ACCOUNT
}

enum SeedlingGrowthStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ManufacturingStatus {
  PENDING
  NORMAL
  WASTAGE_DETECTED
  GOOD_UTILIZATION
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL //withdraw
  TRANSFER
  SALE_PAYMENT //for payments received from sales, projects, events, etc.
  REFUND //for sale refunds and supply payment refunds
}

// System config - Optimized indexes
model Company {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  tel1        String
  tel2        String?
  address     String
  logo        String?
  website     String?
  tinNumber   String?
  description String?
  foundedYear Int?
  industry    String?
  employees   String?
  workHours   Float?   @default(8.0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([name])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([name])
}

// Store with optimized relationships
model Store {
  id                  Int        @id @default(autoincrement())
  name                String
  branchId            Int
  deptId              Int
  branch              Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dept                Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  authorizedPersonnel Json? // Consider normalizing if frequently queried

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  ProductInventory     ProductInventory[]
  Sales                Sale[]
  fromInventoryRecords InventoryRecord[]  @relation("FromStore")
  toInventoryRecords   InventoryRecord[]  @relation("ToStore")
  Supply               Supply[]
  Manufacturing        Manufacturing[]

  @@index([branchId, deptId])
  @@index([name])
  @@map("stores") // Explicit table name
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String
  value     Float?
  abr       String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  ProductInventory          ProductInventory[]
  InventoryRecord           InventoryRecord[]
  ExhibitionInventory       ExhibitionInventory[]
  ExhibitionInventoryRecord ExhibitionInventoryRecord[]
  Supply                    Supply[]
  primaryUnitManufacturings Manufacturing[]             @relation("PrimaryUnit")
  packingUnitManufacturings Manufacturing[]             @relation("PackingUnit")

  @@unique([name])
  @@map("units")
}

// Branch with composite indexes
model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Employee      Employee[]
  Department    Department[]
  Store         Store[]
  branchExpense branchExpense[]

  @@index([name, location])
  @@map("branches")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Employee Employee[]
  Store    Store[]

  @@index([branchId])
  @@index([name])
  @@map("departments")
}

// Permission system optimized
model Permission {
  id        Int      @id @default(autoincrement())
  module    String
  name      String
  value     String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Role Role[]

  @@index([module, name])
  @@map("permissions")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  Employee Employee[]

  @@map("roles")
}

// Employee with optimized indexes for login
model Employee {
  id                    Int         @id @default(autoincrement())
  firstName             String
  lastName              String
  gender                Gender
  /// Only people who sign in need an email and password.
  email                 String?     @unique
  tel                   String      @unique
  password              String?
  salary                Decimal     @db.Decimal(10, 2)
  hasAccess             Boolean     @default(false)
  hasPrescriptionAccess Boolean     @default(false)
  isActive              Boolean     @default(true)
  profileImage          String?
  roleId                Int
  role                  Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId              Int?
  deptId                Int?
  branch                Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dept                  Department? @relation(fields: [deptId], references: [id], onDelete: Cascade)
  updatedAt             DateTime    @updatedAt
  createdAt             DateTime    @default(now())

  // Relations
  EmailVerification             EmailVerification[]
  InventoryRecord               InventoryRecord[]
  Sales                         Sale[]
  ExhibitionSales               ExhibitionSales[]
  ProjectSales                  ProjectSales[]
  ExhibitionInventoryRecords    ExhibitionInventoryRecord[]
  ProjectPayments               ProjectPayments[]
  EmployeeLoginLogs             EmployeeLoginLogs[]
  branchExpense                 branchExpense[]
  SalePayments                  SalePayments[]
  MassageSales                  MassageSales[]
  MassageServicePayments        MassageServicePayments[]
  Attendance                    Attendance[]
  ClientPrescription            ClientPrescription[]
  DeliveryNote                  DeliveryNote[]
  Supply                        Supply[]
  SupplyPayments                SupplyPayments[]
  manufacturings                Manufacturing[]
  TicketScan                    TicketScan[]
  SalePaymentTransactionHistory SalePaymentTransactionHistory[]

  @@index([email, isActive])
  @@index([roleId])
  @@index([branchId, deptId])
  @@index([createdAt])
  @@map("employees")
}

model EmployeeLoginLogs {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("employee_login_logs")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([expiresAt])
  @@map("email_verifications")
}

// Items with optimized indexing
model ItemCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Item Item[]

  @@map("item_categories")
}

model Item {
  id         Int           @id @default(autoincrement())
  categoryId Int?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  showInPos  Boolean       @default(false)
  name       String
  price      Decimal       @db.Decimal(10, 2)
  barcode    String?
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())

  ProductInventory           ProductInventory[]
  InventoryRecord            InventoryRecord[]
  ExhibitionInventory        ExhibitionInventory[]
  ExhibitionInventoryRecords ExhibitionInventoryRecord[]
  Supply                     Supply[]

  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@index([createdAt])
  @@map("items")
}

model Service {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([name])
  @@map("services")
}

// ProductInventory with composite indexes for store queries
model ProductInventory {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId   Int
  qty       Float
  unitId    Int
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([itemId, storeId, unitId])
  @@index([storeId, itemId])
  @@index([qty])
  @@map("product_inventory")
}

// Inventory records with optimized date queries
model InventoryRecord {
  id       Int                     @id @default(autoincrement())
  category InventoryRecordCategory
  itemId   Int
  item     Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  storeId Int
  store   Store @relation("FromStore", fields: [storeId], references: [id], onDelete: Cascade)

  toStoreId Int?
  toStore   Store? @relation("ToStore", fields: [toStoreId], references: [id], onDelete: Cascade)

  deliveryNoteId Int?
  deliveryNote   DeliveryNote? @relation("dn", fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  initiatedQty      Float?
  qty               Float
  remainingQuantity Float?
  unitId            Int
  unit              Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source            String
  description       String?
  recordedBy        Int
  employee          Employee            @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  transferId        String?
  transferStatus    StockTransferStatus @default(CONFIRMED)
  isResolved        Boolean?
  resolveNotes      String?
  images            Json?
  extraNote         String?
  expectedOutput    Float?
  recordedOutput    Float?
  updatedAt         DateTime            @updatedAt
  createdAt         DateTime            @default(now())

  @@index([storeId, createdAt])
  @@index([itemId, createdAt])
  @@index([category, createdAt])
  @@index([recordedBy, createdAt])
  @@map("inventory_records")
}

// SALES - HEAVILY OPTIMIZED FOR POS
model Sale {
  id             Int            @id @default(autoincrement())
  clientId       Int?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items          Json
  servedBy       Int
  employee       Employee       @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  storeId        Int
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleStatus     SaleStatus     @default(SUCCESSFUL)
  status         PaymentStatus
  total          Decimal        @db.Decimal(10, 2)
  balance        Decimal        @db.Decimal(10, 2)
  paymentMethods Json
  notes          String?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  SalePayments   SalePayments[]

  // One-to-One relationship with PatientAccountTransaction using same ID
  patientAccountTransaction PatientAccountTransaction?

  // Comprehensive indexing for fast queries
  @@index([storeId, createdAt])
  @@index([servedBy, createdAt])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
  @@index([total])
  @@map("sales")
}

model SalePayments {
  id                            Int                             @id @default(autoincrement())
  saleId                        Int
  sale                          Sale                            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount                        Decimal                         @db.Decimal(10, 2)
  paymentMethod                 PaymentMethodType
  referenceId                   String?
  notes                         String?
  cashierId                     Int
  employee                      Employee                        @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  updatedAt                     DateTime                        @updatedAt
  createdAt                     DateTime                        @default(now())
  SalePaymentTransactionHistory SalePaymentTransactionHistory[]

  @@index([createdAt])
  @@map("salesPayments")
}

model SalePaymentTransactionHistory {
  id Int @id @default(autoincrement())

  // Relationship to sale payment
  salePaymentId Int?
  salePayment   SalePayments? @relation(fields: [salePaymentId], references: [id], onDelete: Cascade)

  // Transaction identification
  transaction_uuid        String  @unique
  transaction_reference   String  @unique
  provider_transaction_id String? @unique

  // Amount information
  amount           Decimal @db.Decimal(10, 2)
  amount_formatted String?
  currency         String  @default("UGX")

  // Payment provider details
  payment_method PaymentMethodType
  provider       String? // "mtn", "airtel", "card payments"
  provider_mode  String? // "mtnuganda", "airteluganda", "card paymentsuganda"
  phone_number   String?

  // Transaction status
  status     WithdrawStatus @default(PENDING)
  event_type String? // "collection.completed", "collection.failed"

  // Description and notes
  description String? @db.Text
  notes       String? @db.Text

  // Cashier/employee info
  cashierId Int
  employee  Employee @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  // Webhook tracking
  webhook_received_at DateTime @default(now())
  webhook_payload     Json? // Store raw webhook payload for debugging

  // Timestamps
  transaction_initiated_at DateTime? // From webhook created_at
  transaction_completed_at DateTime? // From webhook updated_at
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  // Indexes for better query performance
  @@index([salePaymentId])
  @@index([transaction_uuid])
  @@index([transaction_reference])
  @@index([provider_transaction_id])
  @@index([provider])
  @@index([phone_number])
  @@index([created_at])
  @@index([payment_method])
  @@map("sale_payment_transaction_history")
}

// Clientele optimized
model Client {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  phone      String?  @unique
  address    String?
  hasAccount Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  Sales              Sale[]
  ExhibitionSales    ExhibitionSales[]
  ProjectSales       ProjectSales[]
  MassageSales       MassageSales[]
  ClientPrescription ClientPrescription[]
  PatientAccount     PatientAccount[]

  @@index([firstName, lastName])
  @@index([phone])
  @@index([createdAt])
  @@map("clients")
}

enum AccountStatus {
  INACTIVE
  ACTIVE
}

model PatientAccount {
  id                        Int                         @id @default(autoincrement())
  clientId                  Int
  client                    Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balance                   Float                       @default(0.00)
  status                    AccountStatus               @default(ACTIVE)
  updatedAt                 DateTime                    @updatedAt
  createdAt                 DateTime                    @default(now())
  PatientAccountTransaction PatientAccountTransaction[]
}

model PatientAccountTransaction {
  id        Int                          @id @default(autoincrement())
  saleId    Int?                  @unique
  sale      Sale?                        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  accountId Int
  account   PatientAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      PatientAcountTransactionType
  amount    Float                        @default(0.00)
  notes     String?
  updatedAt DateTime                     @updatedAt
  createdAt DateTime                     @default(now())

  // Indexes for performance
  @@index([accountId, createdAt])
  @@index([type])
  @@map("patient_account_transactions")
}

// Event system optimized
model Event {
  id           Int         @id @default(autoincrement())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  ticketPrice  Decimal     @db.Decimal(10, 2)
  capacity     Int?
  walletId     Int
  wallet       Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  ticketsSold  Int         @default(0)
  totalRevenue Decimal     @default(0) @db.Decimal(10, 2)
  status       EventStatus @default(OPEN)
  location     String?
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  EventParticipant EventParticipant[]
  Ticket           Ticket[]

  @@index([startDate, endDate])
  @@index([status])
  @@index([title])
  @@map("events")
}

model EventParticipant {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  tel             String
  tel2            String?
  email           String?
  reservationCode String
  eventId         Int      @db.Int
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  Ticket          Ticket[]

  @@index([eventId])
  @@index([tel])
  @@index([createdAt])
  @@map("event_participants")
}

model Ticket {
  id             Int                @id @default(autoincrement())
  eventId        Int                @db.Int
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amountPaid     Decimal            @db.Decimal(10, 2)
  balance        Decimal            @db.Decimal(10, 2)
  paymentStatus  EventPaymentStatus @default(UNPAID)
  ticketcode     String             @unique @db.Char(36)
  participantId  Int                @db.Int
  participant    EventParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  numberOfScans  Int                @default(0)
  lastScannedAt  DateTime?
  status         TicketStatus       @default(ACTIVE)
  emailSent      Boolean            @default(false)
  smsSent        Boolean            @default(false)
  ticketSentAt   DateTime?
  ticketToken    String             @db.Text
  updatedAt      DateTime           @updatedAt
  createdAt      DateTime           @default(now())
  TicketScan     TicketScan[]
  TicketPayments TicketPayments[]

  @@index([eventId])
  @@index([participantId])
  @@map("tickets")
}

model TicketScan {
  id            Int      @id @default(autoincrement())
  ticketId      Int      @db.Int
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedBy     Int      @db.Int
  scannedByUser Employee @relation(fields: [scannedBy], references: [id], onDelete: Cascade)
  deviceInfo    String?
  location      String?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([scannedBy])
}

model TicketPayments {
  id            Int                @id @default(autoincrement())
  ticketId      Int                @db.Int
  ticket        Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  paymentStatus EventPaymentStatus @default(UNPAID)
  amount        Decimal            @db.Decimal(10, 2)
  paymentMethod String
  paymentDate   DateTime
  updatedAt     DateTime           @updatedAt
  createdAt     DateTime           @default(now())

  @@index([ticketId])
  @@map("ticket_payments")
}

model Withdraw {
  id        Int            @id @default(autoincrement())
  amount    Decimal        @db.Decimal(10, 2)
  walletId  Int
  wallet    Wallet         @relation(fields: [walletId], references: [id])
  status    WithdrawStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WithdrawChannel {
  id                      Int                       @id @default(autoincrement())
  type                    ChannelType
  name                    String
  phoneNumber             String?
  bank                    String?
  accountNumber           String?
  isVerified              Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  ChannelVerificationCode ChannelVerificationCode[]
  TransactionHistory      TransactionHistory[]
  WithdrawHistory         WithdrawHistory[]
}

model ChannelVerificationCode {
  id        Int             @id @default(autoincrement())
  channelId Int
  channel   WithdrawChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([channelId, createdAt])
}

model TransactionHistory {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  amount          Decimal         @db.Decimal(10, 2)
  channelId       Int
  channel         WithdrawChannel @relation(fields: [channelId], references: [id])
  status          WithdrawStatus
  description     String?         @db.Text
  reference       String          @unique
  phoneNumber     String?
  transactionId   String          @unique
  provider        String?
  currency        String
  statusUpdatedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Wallet {
  id              Int               @id @default(autoincrement())
  name            String
  purpose         String?
  balance         Decimal           @default(0) @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())
  isForSales      Boolean           @default(false)
  isForTickets    Boolean           @default(false)
  /// The Monk Loyalty Club wallet (registration fees are credited here).
  isForClub       Boolean           @default(false)
  canBeDeleted    Boolean           @default(false)
  updatedAt       DateTime          @updatedAt
  Withdraw        Withdraw[]
  Event           Event[]
  WithdrawHistory WithdrawHistory[]
}

model WithdrawHistory {
  id                       Int             @id @default(autoincrement())
  amount                   Decimal         @db.Decimal(10, 2)
  walletId                 Int
  wallet                   Wallet          @relation(fields: [walletId], references: [id])
  channelId                Int
  channel                  WithdrawChannel @relation(fields: [channelId], references: [id])
  description              String?         @db.Text
  reference                String          @unique
  status                   WithdrawStatus
  transaction_completed_at DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

// Exhibition optimized
model Exhibition {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  description String?
  startDate   DateTime
  endDate     DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  ExhibitionStore    ExhibitionStore[]
  ExhibitionExpenses ExhibitionExpenses[]

  @@index([startDate, endDate])
  @@index([name])
  @@map("exhibitions")
}

model ExhibitionStore {
  id           Int        @id @default(autoincrement())
  name         String
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  ExhibitionInventory        ExhibitionInventory[]
  ExhibitionInventoryRecords ExhibitionInventoryRecord[]
  ExhibitionSales            ExhibitionSales[]

  @@unique([exhibitionId, name])
  @@index([exhibitionId])
  @@map("exhibition_stores")
}

model ExhibitionInventory {
  id        Int                     @id @default(autoincrement())
  category  InventoryRecordCategory
  storeId   Int
  store     ExhibitionStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty       Float
  unitId    Int
  unit      Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  updatedAt DateTime                @updatedAt
  createdAt DateTime                @default(now())

  @@unique([storeId, itemId, unitId])
  @@index([storeId])
  @@map("exhibition_inventory")
}

model ExhibitionInventoryRecord {
  id          Int                     @id @default(autoincrement())
  storeId     Int
  store       ExhibitionStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    InventoryRecordCategory
  itemId      Int
  item        Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty         Float
  unitId      Int
  unit        Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source      String
  description String?
  recordedBy  Int
  employee    Employee                @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  updatedAt   DateTime                @updatedAt
  createdAt   DateTime                @default(now())

  @@index([storeId, createdAt])
  @@index([recordedBy, createdAt])
  @@map("exhibition_inventory_records")
}

model ExhibitionSales {
  id                Int             @id @default(autoincrement())
  clientId          Int
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items             Json
  total             Decimal         @db.Decimal(10, 2)
  status            PaymentStatus
  balance           Decimal         @db.Decimal(10, 2)
  paymentMethods    Json
  notes             String?
  exhibitionStoreId Int
  exhibitionStore   ExhibitionStore @relation(fields: [exhibitionStoreId], references: [id], onDelete: Cascade)
  servedBy          Int
  employee          Employee        @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @updatedAt
  createdAt         DateTime        @default(now())

  @@index([servedBy, createdAt])
  @@index([clientId])
  @@map("exhibition_sales")
}

model ExhibitionExpenses {
