generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ENUMS - Keep as is, they're efficient
enum InventoryRecordCategory {
  RESTOCK
  DEPLETION
  TRANSFER
  ADJUSTMENT
  MANUFACTURING
}

enum StockTransferStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum PaymentType {
  CASH
  CHEQUE
  MOBILE_MONEY
  BARTER_PAYMENT
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  TRANSPORT
  INSURANCE
  MARKETING
  TRAINING
  TAXES
  MEDICAL_SUPPLIES
  OFFICE_SUPPLIES
  EQUIPMENT_PURCHASE
  EQUIPMENT_REPAIR
  CLEANING
  SECURITY
  INTERNET
  WATER
  ELECTRICITY
  COMMUNICATION
  SOFTWARE_SUBSCRIPTIONS
  MISCELLANEOUS
}

enum Gender {
  MALE
  FEMALE
}

enum ChequeStatus {
  PENDING
  PAID
  BOUNCED
}

enum Status {
  APPROVED
  PENDING
  REJECTED
}

enum EventStatus {
  OPEN
  CLOSED
}

enum EventPaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum SaleStatus {
  FULLY_PAID
  UNPAID
  PARTIALLY_PAID
}

enum PaymentMethodType {
  CASH
  MTN_MOMO
  AIRTEL_MOMO
  CARD
  PROF_MOMO
}

enum SeedlingGrowthStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ManufacturingStatus {
  PENDING
  NORMAL
  WASTAGE_DETECTED
  GOOD_UTILIZATION
}

// System config - Optimized indexes
model Company {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  tel1        String
  tel2        String?
  address     String
  logo        String?
  website     String?
  tinNumber   String?
  description String?
  foundedYear Int?
  industry    String?
  employees   String?
  workHours   Float?   @default(8.0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([name])
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([name])
}

// Store with optimized relationships
model Store {
  id                  Int        @id @default(autoincrement())
  name                String
  branchId            Int
  deptId              Int
  branch              Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dept                Department @relation(fields: [deptId], references: [id], onDelete: Cascade)
  authorizedPersonnel Json? // Consider normalizing if frequently queried

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  ProductInventory     ProductInventory[]
  Sales                Sale[]
  fromInventoryRecords InventoryRecord[]  @relation("FromStore")
  toInventoryRecords   InventoryRecord[]  @relation("ToStore")
  Supply               Supply[]
  Manufacturing        Manufacturing[]

  @@index([branchId, deptId])
  @@index([name])
  @@map("stores") // Explicit table name
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String
  value     Float?
  abr       String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  ProductInventory          ProductInventory[]
  InventoryRecord           InventoryRecord[]
  ExhibitionInventory       ExhibitionInventory[]
  ExhibitionInventoryRecord ExhibitionInventoryRecord[]
  Supply                    Supply[]
  primaryUnitManufacturings Manufacturing[]             @relation("PrimaryUnit")
  packingUnitManufacturings Manufacturing[]             @relation("PackingUnit")

  @@unique([name])
  @@map("units")
}

// Branch with composite indexes
model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Employee      Employee[]
  Department    Department[]
  Store         Store[]
  branchExpense branchExpense[]

  @@index([name, location])
  @@map("branches")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Employee Employee[]
  Store    Store[]

  @@index([branchId])
  @@index([name])
  @@map("departments")
}

// Permission system optimized
model Permission {
  id        Int      @id @default(autoincrement())
  module    String
  name      String
  value     String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Role Role[]

  @@index([module, name])
  @@map("permissions")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  permissions Permission[]
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  Employee Employee[]

  @@map("roles")
}

// Employee with optimized indexes for login
model Employee {
  id                    Int         @id @default(autoincrement())
  firstName             String
  lastName              String
  gender                Gender
  email                 String      @unique
  tel                   String      @unique
  password              String
  salary                Decimal     @db.Decimal(10, 2)
  hasAccess             Boolean     @default(false)
  hasPrescriptionAccess Boolean     @default(false)
  isActive              Boolean     @default(true)
  profileImage          String?
  roleId                Int
  role                  Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId              Int?
  deptId                Int?
  branch                Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dept                  Department? @relation(fields: [deptId], references: [id], onDelete: Cascade)
  updatedAt             DateTime    @updatedAt
  createdAt             DateTime    @default(now())

  // Relations
  EmailVerification          EmailVerification[]
  InventoryRecord            InventoryRecord[]
  Sales                      Sale[]
  ExhibitionSales            ExhibitionSales[]
  ProjectSales               ProjectSales[]
  ExhibitionInventoryRecords ExhibitionInventoryRecord[]
  ProjectPayments            ProjectPayments[]
  EmployeeLoginLogs          EmployeeLoginLogs[]
  branchExpense              branchExpense[]
  SalePayments               SalePayments[]
  MassageSales               MassageSales[]
  MassageServicePayments     MassageServicePayments[]
  Attendance                 Attendance[]
  ClientPrescription         ClientPrescription[]
  DeliveryNote               DeliveryNote[]
  Supply                     Supply[]
  SupplyPayments             SupplyPayments[]
  manufacturings             Manufacturing[]

  @@index([email, isActive])
  @@index([roleId])
  @@index([branchId, deptId])
  @@index([createdAt])
  @@map("employees")
}

model EmployeeLoginLogs {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("employee_login_logs")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime

  employee Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([expiresAt])
  @@map("email_verifications")
}

// Items with optimized indexing
model ItemCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Item Item[]

  @@map("item_categories")
}

model Item {
  id         Int           @id @default(autoincrement())
  categoryId Int?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  showInPos  Boolean       @default(false)
  name       String
  price      Decimal       @db.Decimal(10, 2)
  barcode    String?
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())

  ProductInventory           ProductInventory[]
  InventoryRecord            InventoryRecord[]
  ExhibitionInventory        ExhibitionInventory[]
  ExhibitionInventoryRecords ExhibitionInventoryRecord[]
  Supply                     Supply[]

  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@index([createdAt])
  @@map("items")
}

model Service {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([name])
  @@map("services")
}

// ProductInventory with composite indexes for store queries
model ProductInventory {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storeId   Int
  qty       Float
  unitId    Int
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([itemId, storeId, unitId])
  @@index([storeId, itemId])
  @@index([qty])
  @@map("product_inventory")
}

// Inventory records with optimized date queries
model InventoryRecord {
  id       Int                     @id @default(autoincrement())
  category InventoryRecordCategory
  itemId   Int
  item     Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  storeId Int
  store   Store @relation("FromStore", fields: [storeId], references: [id], onDelete: Cascade)

  toStoreId Int?
  toStore   Store? @relation("ToStore", fields: [toStoreId], references: [id], onDelete: Cascade)

  deliveryNoteId Int?
  deliveryNote   DeliveryNote? @relation("dn", fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  initiatedQty      Float?
  qty               Float
  remainingQuantity Float?
  unitId            Int
  unit              Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source            String
  description       String?
  recordedBy        Int
  employee          Employee            @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  transferId        String?
  transferStatus    StockTransferStatus @default(CONFIRMED)
  isResolved        Boolean?
  resolveNotes      String?
  images            Json?
  extraNote         String?
  expectedOutput    Float?
  recordedOutput    Float?
  updatedAt         DateTime            @updatedAt
  createdAt         DateTime            @default(now())

  @@index([storeId, createdAt])
  @@index([itemId, createdAt])
  @@index([category, createdAt])
  @@index([recordedBy, createdAt])
  @@map("inventory_records")
}

// SALES - HEAVILY OPTIMIZED FOR POS
model Sale {
  id             Int            @id @default(autoincrement())
  clientId       Int?
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items          Json // Array of CartItemDto - consider normalized table for large systems
  servedBy       Int
  employee       Employee       @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  storeId        Int
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status         SaleStatus
  total          Decimal        @db.Decimal(10, 2)
  balance        Decimal        @db.Decimal(10, 2)
  paymentMethods Json // Array of PaymentMethodDto
  notes          String?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  SalePayments   SalePayments[]

  // Comprehensive indexing for fast queries
  @@index([storeId, createdAt])
  @@index([servedBy, createdAt])
  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt]) // For date range queries
  @@index([total])
  @@map("sales")
}

model SalePayments {
  id            Int               @id @default(autoincrement())
  saleId        Int
  sale          Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethodType
  referenceId   String?
  notes         String?
  cashierId     Int
  employee      Employee          @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@index([createdAt])
  @@map("salesPayments")
}

// Clientele optimized
model Client {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone   String   @unique
  address   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  Sales              Sale[]
  ExhibitionSales    ExhibitionSales[]
  ProjectSales       ProjectSales[]
  MassageSales       MassageSales[]
  ClientPrescription ClientPrescription[]

  @@index([firstName, lastName])
  @@index([phone])
  @@index([createdAt])
  @@map("clients")
}

// Event system optimized
model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  ticketPrice Decimal     @db.Decimal(10, 2)
  status      EventStatus @default(OPEN)
  location    String?
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  EventParticipant EventParticipant[]

  @@index([startDate, endDate])
  @@index([status])
  @@index([title])
  @@map("events")
}

model EventParticipant {
  id            Int                @id @default(autoincrement())
  firstName     String
  lastName      String
  tel           String
  tel2          String
  amountPaid    Decimal            @db.Decimal(10, 2)
  balance       Decimal            @db.Decimal(10, 2)
  paymentStatus EventPaymentStatus @default(UNPAID)
  eventId       Int
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedAt     DateTime           @updatedAt
  createdAt     DateTime           @default(now())

  @@index([eventId, paymentStatus])
  @@index([tel])
  @@index([createdAt])
  @@map("event_participants")
}

// Exhibition optimized
model Exhibition {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  description String?
  startDate   DateTime
  endDate     DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  ExhibitionStore    ExhibitionStore[]
  ExhibitionExpenses ExhibitionExpenses[]

  @@index([startDate, endDate])
  @@index([name])
  @@map("exhibitions")
}

model ExhibitionStore {
  id           Int        @id @default(autoincrement())
  name         String
  exhibitionId Int
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  ExhibitionInventory        ExhibitionInventory[]
  ExhibitionInventoryRecords ExhibitionInventoryRecord[]
  ExhibitionSales            ExhibitionSales[]

  @@unique([exhibitionId, name])
  @@index([exhibitionId])
  @@map("exhibition_stores")
}

model ExhibitionInventory {
  id        Int                     @id @default(autoincrement())
  category  InventoryRecordCategory
  storeId   Int
  store     ExhibitionStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty       Float
  unitId    Int
  unit      Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  updatedAt DateTime                @updatedAt
  createdAt DateTime                @default(now())

  @@unique([storeId, itemId, unitId])
  @@index([storeId])
  @@map("exhibition_inventory")
}

model ExhibitionInventoryRecord {
  id          Int                     @id @default(autoincrement())
  storeId     Int
  store       ExhibitionStore         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    InventoryRecordCategory
  itemId      Int
  item        Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty         Float
  unitId      Int
  unit        Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  source      String
  description String?
  recordedBy  Int
  employee    Employee                @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  updatedAt   DateTime                @updatedAt
  createdAt   DateTime                @default(now())

  @@index([storeId, createdAt])
  @@index([recordedBy, createdAt])
  @@map("exhibition_inventory_records")
}

model ExhibitionSales {
  id                Int             @id @default(autoincrement())
  clientId          Int
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items             Json
  total             Decimal         @db.Decimal(10, 2)
  status            SaleStatus
  balance           Decimal         @db.Decimal(10, 2)
  paymentMethods    Json
  notes             String?
  exhibitionStoreId Int
  exhibitionStore   ExhibitionStore @relation(fields: [exhibitionStoreId], references: [id], onDelete: Cascade)
  servedBy          Int
  employee          Employee        @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  updatedAt         DateTime        @updatedAt
  createdAt         DateTime        @default(now())

  @@index([servedBy, createdAt])
  @@index([clientId])
  @@map("exhibition_sales")
}

model ExhibitionExpenses {
  id           Int             @id @default(autoincrement())
  category     ExpenseCategory
  exhibitionId Int
  exhibition   Exhibition      @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  amount       Float
  dateIncurred DateTime
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())
}

// Projects optimized
model Project {
  id           Int            @id @default(autoincrement())
  name         String
  price        Decimal        @db.Decimal(10, 2)
  barcode      String?
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())
  ProjectSales ProjectSales[]

  @@index([name])
  @@index([barcode])
  @@map("projects")
}

model ProjectSales {
  id                   Int        @id @default(autoincrement())
  clientId             Int
  client               Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId            Int
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status               SaleStatus
  saleTotal            Decimal    @db.Decimal(10, 2)
  downPayment          Decimal    @db.Decimal(10, 2)
  numberOfInstallments Int
  installmentAmount    Decimal    @db.Decimal(10, 2)
  deliveryNoteImage    String?
  cashierId            Int
  employee             Employee   @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  updatedAt            DateTime   @updatedAt
  createdAt            DateTime   @default(now())

  ProjectPayments ProjectPayments[]

  @@index([clientId])
  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@map("project_sales")
}

model ProjectPayments {
  id                   Int               @id @default(autoincrement())
  saleId               Int
  projectSale          ProjectSales      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount               Decimal           @db.Decimal(10, 2)
  exhibitionId         Int
  paymentMethod        PaymentMethodType
  referenceId          String?
  notes                String?
  receiptImage         String?
  bankDepositSlipImage String?
  cashierId            Int
  employee             Employee          @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  updatedAt            DateTime          @updatedAt
  createdAt            DateTime          @default(now())

  @@index([saleId, createdAt])
  @@index([cashierId, createdAt])
  @@map("project_payments")
}

// Cheque Management optimized
model Bank {
  id            Int      @id @default(autoincrement())
  name          String
  accountNumber String?
  balance       Decimal? @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  Cheque Cheque[]

  @@unique([name])
  @@index([accountNumber])
  @@map("banks")
}

model Cheque {
  id              Int          @id @default(autoincrement())
  chequeNumber    String
  bankId          Int
  bank            Bank         @relation(fields: [bankId], references: [id], onDelete: Cascade)
  DraweeFirstName String
  DraweeLastName  String?
  contact         String?
  Address         String?
  reason          String?
  amount          Decimal      @db.Decimal(10, 2)
  status          ChequeStatus @default(PENDING)
  bankingDate     DateTime
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())

  @@index([bankId, status])
  @@index([chequeNumber])
  @@index([bankingDate])
  @@index([status, createdAt])
  @@map("cheques")
}

model branchExpense {
  id           Int             @id @default(autoincrement())
  branchId     Int
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  title        String
  description  String?
  receiptImage String?
  amount       Float
  dateIncurred DateTime
  recordedBy   Int
  employee     Employee        @relation(fields: [recordedBy], references: [id], onDelete: Cascade)
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@index([branchId, dateIncurred])
  @@map("branch_expenses")
}

//massage
model MassageSales {
  id                     Int                      @id @default(autoincrement())
  clientId               Int
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items                  Json
  total                  Decimal                  @db.Decimal(10, 2)
  status                 SaleStatus
  balance                Decimal                  @db.Decimal(10, 2)
  paymentMethods         Json
  notes                  String?
  servedBy               Int
  employee               Employee                 @relation(fields: [servedBy], references: [id], onDelete: Cascade)
  updatedAt              DateTime                 @updatedAt
  createdAt              DateTime                 @default(now())
  MassageServicePayments MassageServicePayments[]

  @@index([createdAt])
  @@index([clientId])
  @@map("massage_sales")
}

model MassageServicePayments {
  id            Int               @id @default(autoincrement())
  saleId        Int
  sale          MassageSales      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethodType
  referenceId   String?
  notes         String?
  cashierId     Int
  employee      Employee          @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@index([createdAt])
  @@map("massageServicePayments")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  date        String
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeIn      DateTime
  timeOut     DateTime?
  missedHours Float?
  notes       String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model PayrollPeriods {
  id          Int      @id @default(autoincrement())
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime // <-- add this
  totalSpent  Decimal
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  payrolls Payroll[] // <-- relation renamed for clarity
}

model Payroll {
  id               Int            @id @default(autoincrement())
  payrollPeriodId  Int
  payrollPeriod    PayrollPeriods @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  paymentStructure Json
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())
}

model ClientPrescription {
  id           Int      @id @default(autoincrement())
  clientId     Int
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  images       Json
  notes        String?
  prescribedBy Int
  employee     Employee @relation(fields: [prescribedBy], references: [id], onDelete: Cascade)
  isReviewed   Boolean  @default(false)
  reviewNotes  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model DeliveryNote {
  id                 Int      @id @default(autoincrement())
  name               String
  deliveryNoteNumber String
  images             Json
  registeredBy       Int
  employee           Employee @relation(fields: [registeredBy], references: [id], onDelete: Cascade)
  notes              String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  InventoryRecord InventoryRecord[] @relation("dn")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  contact   String   @unique
  address   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  Supply    Supply[]

  @@index([firstName, lastName])
  @@index([contact])
  @@index([createdAt])
}

model Supply {
  id                 Int                @id @default(autoincrement())
  itemId             Int
  item               Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId         Int
  supplier           Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  qty                Float
  unitId             Int
  uom                Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  value              Decimal            @db.Decimal(10, 2)
  balance            Decimal            @db.Decimal(10, 2)
  recievedBy         Int
  employee           Employee           @relation(fields: [recievedBy], references: [id], onDelete: Cascade)
  paymentStatus      EventPaymentStatus @default(UNPAID)
  proofImage         String?
  destinationStoreId Int
  destinationStore   Store              @relation(fields: [destinationStoreId], references: [id], onDelete: Cascade)
  updatedAt          DateTime           @updatedAt
  createdAt          DateTime           @default(now())
  SupplyPayments     SupplyPayments[]

  @@index([supplierId])
  @@index([createdAt])
}

model SupplyPayments {
  id                Int                @id @default(autoincrement())
  supplyId          Int
  supply            Supply             @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  bank              String?
  chequeNumber      String?
  chequeBankingDate DateTime?
  paymentType       PaymentType
  barterItemName    String?
  amount            Decimal            @db.Decimal(10, 2)
  paidBy            Int
  employee          Employee           @relation(fields: [paidBy], references: [id], onDelete: Cascade)
  paymentStatus     EventPaymentStatus
  proofImage        String?
  updatedAt         DateTime           @updatedAt
  createdAt         DateTime           @default(now())
}

model SeedlingStages {
  id                    Int                    @id @default(autoincrement())
  name                  String
  stageDays             Float
  updatedAt             DateTime               @updatedAt
  createdAt             DateTime               @default(now())
  seedlingBatches       SeedlingBatch[]
  seedlingBatchTrackers SeedlingBatchTracker[]
  seedlingDeaths        SeedlingDeath[]

  @@index([name])
  @@index([createdAt])
}

model SeedlingBatch {
  id                      Int                    @id @default(autoincrement())
  batchNumber             String
  currentStageId          Int
  currentStage            SeedlingStages         @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  seedlings               Json
  daysSpentInCurrentStage Float
  status                  SeedlingGrowthStatus
  notes                   String?
  updatedAt               DateTime               @updatedAt
  createdAt               DateTime               @default(now())
  seedlingBatchTrackers   SeedlingBatchTracker[]
  seedlingDeaths          SeedlingDeath[]
}

model SeedlingBatchTracker {
  id                          Int            @id @default(autoincrement())
  batchId                     Int
  batch                       SeedlingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  currentStageId              Int
  currentStage                SeedlingStages @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  startDate                   DateTime
  endDate                     DateTime
  seedlingsLostAtCurrentStage Json?
  daysToNextStage             Float
  updatedAt                   DateTime       @updatedAt
  createdAt                   DateTime       @default(now())
}

model SeedlingDeath {
  id        Int            @id @default(autoincrement())
  batchId   Int
  batch     SeedlingBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stageId   Int
  stage     SeedlingStages @relation(fields: [stageId], references: [id], onDelete: Cascade)
  seedlings Json
  reason    String?
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())
}

// Manufacturing model - Product manufacturing records
model Manufacturing {
  id              Int                 @id @default(autoincrement())
  storeId         Int
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  primaryUnitId   Int // Unit ID for primary unit (L or KG)
  primaryUnit     Unit                @relation("PrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: Cascade)
  unitId          Int // Unit ID for packing unit
  unit            Unit                @relation("PackingUnit", fields: [unitId], references: [id], onDelete: Cascade)
  totalQuantity   Float // Total quantity in primary unit (L or KG)
  estimatedOutput Float // Estimated number of output units/pieces
  actualOutput    Float? // Actual number of output units/pieces (filled after packing)
  status          ManufacturingStatus @default(PENDING) // Status: PENDING, NORMAL, WASTAGE_DETECTED, GOOD_UTILIZATION
  items           Json // Array of manufacturing items: [{ itemId, itemName, quantity }]
  manufacturedBy  Int
  employee        Employee            @relation(fields: [manufacturedBy], references: [id], onDelete: Cascade)
  notes           String?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  @@index([storeId, createdAt])
  @@index([manufacturedBy, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("manufacturing")
}
